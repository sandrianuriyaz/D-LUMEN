DLUMEN_TOKEN=ganti-dengan-token-acak-yang-sama-di-semua-node
DLUMEN_MASTER_PORT=5050
DLUMEN_DISCOVERY_PORT=5005
DLUMEN_WORKER_PORT=5002
DLUMEN_WORKER_ID=
DLUMEN_PROCESSES=2
# Kosong hanya bila node memiliki semua data. Contoh: 2020,2021 atau 2020-*,2021-*.
DLUMEN_PARTITIONS=2020,2021
# Fallback jika UDP broadcast diblokir: http://alamat-master:5050
DLUMEN_MASTER_URL=
DLUMEN_DB_NAME=dlumen_db
DLUMEN_DB_USER=postgres
DLUMEN_DB_HOST=127.0.0.1
DLUMEN_DB_PORT=5432
DLUMEN_DB_PASSWORD=
DLUMEN_DATA_DIR=data/raw
DLUMEN_MAX_RETRIES=2
DLUMEN_TASK_TIMEOUT=120
DLUMEN_HEARTBEAT_TIMEOUT=15
